<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/dialog_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_title_new_task"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_title"
            android:textSize="15sp"
            android:textColor="@color/primary"
            android:textColorHint="@color/muted_foreground"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/etTaskDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_description"
            android:textSize="15sp"
            android:textColor="@color/primary"
            android:textColorHint="@color/muted_foreground"
            android:background="@drawable/edit_text_bg"
            android:padding="12dp"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="8dp"
            android:inputType="textMultiLine" />

        <TextView
            android:id="@+id/tvTimeError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/error_time_overlap"
            android:textColor="@color/destructive"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvFreeSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Свободно: 09:00 - 10:00"
            android:textColor="@color/today_fg"
            android:textSize="13sp"
            android:background="@drawable/chip_selected"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_start_time"
                android:textSize="14sp"
                android:textColor="@color/primary" />

            <EditText
                android:id="@+id/btnStartTime"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:text="@string/start_time_default"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:background="@drawable/button_muted"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:inputType="time" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_end_time"
                android:textSize="14sp"
                android:textColor="@color/primary" />

            <EditText
                android:id="@+id/btnEndTime"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:text="@string/end_time_default"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:background="@drawable/button_muted"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:inputType="time" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_duration"
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/layoutDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView android:id="@+id/pillDur30" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginEnd="3dp" android:gravity="center"
                android:text="@string/duration_30min" android:textSize="12sp"
                android:background="@drawable/chip_unselected" android:textColor="@color/muted_foreground"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/pillDur1h" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginEnd="3dp" android:gravity="center"
                android:text="@string/duration_1h" android:textSize="12sp"
                android:background="@drawable/chip_selected" android:textColor="@color/primary_foreground"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/pillDur1_5h" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginEnd="3dp" android:gravity="center"
                android:text="@string/duration_1_5h" android:textSize="12sp"
                android:background="@drawable/chip_unselected" android:textColor="@color/muted_foreground"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/pillDur2h" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginEnd="3dp" android:gravity="center"
                android:text="@string/duration_2h" android:textSize="12sp"
                android:background="@drawable/chip_unselected" android:textColor="@color/muted_foreground"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/pillDur3h" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginEnd="3dp" android:gravity="center"
                android:text="@string/duration_3h" android:textSize="12sp"
                android:background="@drawable/chip_unselected" android:textColor="@color/muted_foreground"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/pillDurCustom" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:gravity="center"
                android:text="+" android:textSize="18sp" android:textStyle="bold"
                android:background="@drawable/chip_unselected" android:textColor="@color/muted_foreground"
                android:clickable="true" android:focusable="true" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_recurrence"
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/layoutRecurrence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="2dp">

            <TextView android:id="@+id/pillRecOnce" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginEnd="3dp" android:gravity="center"
                android:text="@string/recurrence_once" android:textSize="12sp"
                android:background="@drawable/chip_selected" android:textColor="@color/primary_foreground"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/pillRecDaily" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginEnd="3dp" android:gravity="center"
                android:text="@string/recurrence_daily" android:textSize="12sp"
                android:background="@drawable/chip_unselected" android:textColor="@color/muted_foreground"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/pillRecWeekly" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginEnd="3dp" android:gravity="center"
                android:text="@string/recurrence_weekly" android:textSize="12sp"
                android:background="@drawable/chip_unselected" android:textColor="@color/muted_foreground"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/pillRecWeekdays" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:layout_marginEnd="3dp" android:gravity="center"
                android:text="@string/recurrence_weekdays" android:textSize="12sp"
                android:background="@drawable/chip_unselected" android:textColor="@color/muted_foreground"
                android:clickable="true" android:focusable="true" />
            <TextView android:id="@+id/pillRecCustom" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:gravity="center"
                android:text="@string/recurrence_custom_days" android:textSize="12sp"
                android:background="@drawable/chip_unselected" android:textColor="@color/muted_foreground"
                android:clickable="true" android:focusable="true" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRecurrenceDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/chipMon"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/day_mon"
                android:textSize="13sp"
                android:background="@drawable/chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/chipTue"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/day_tue"
                android:textSize="13sp"
                android:background="@drawable/chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/chipWed"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/day_wed"
                android:textSize="13sp"
                android:background="@drawable/chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/chipThu"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/day_thu"
                android:textSize="13sp"
                android:background="@drawable/chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/chipFri"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/day_fri"
                android:textSize="13sp"
                android:background="@drawable/chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/chipSat"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/day_sat"
                android:textSize="13sp"
                android:background="@drawable/chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/chipSun"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/day_sun"
                android:textSize="13sp"
                android:background="@drawable/chip_unselected"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_complexity"
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/tvComplexityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slider_default"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:minWidth="36dp"
                android:layout_marginEnd="16dp" />

            <SeekBar
                android:id="@+id/sliderComplexity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="9"
                android:progress="4" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnFindTime"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Найти время"
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:background="@drawable/button_muted"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="@string/btn_cancel"
                android:textSize="14sp"
                android:textColor="@color/muted_foreground"
                android:gravity="center_vertical"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="@string/btn_add"
                android:textSize="14sp"
                android:textColor="@color/primary_foreground"
                android:background="@drawable/button_black"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
