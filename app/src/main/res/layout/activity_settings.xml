<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/background">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← "
            android:textSize="22sp"
            android:textColor="@color/primary"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sleep_section"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sleep_start"
                android:textSize="14sp"
                android:textColor="@color/muted_foreground"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/sleepStart"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:text="00:00"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:background="@drawable/button_muted"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:inputType="time"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sleep_end"
                android:textSize="14sp"
                android:textColor="@color/muted_foreground"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/sleepEnd"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:text="08:00"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:background="@drawable/button_muted"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:inputType="time"
                android:layout_marginBottom="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginBottom="32dp">

                <TextView
                    android:id="@+id/sleepSave"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="@string/btn_save"
                    android:textSize="14sp"
                    android:textColor="@color/primary_foreground"
                    android:background="@drawable/button_black"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_section"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_label"
                android:textSize="14sp"
                android:textColor="@color/muted_foreground"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="32dp">

                <TextView
                    android:id="@+id/pillThemeSystem"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:text="@string/theme_system"
                    android:textSize="13sp"
                    android:background="@drawable/chip_selected"
                    android:textColor="@color/primary_foreground"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/pillThemeDark"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:gravity="center"
                    android:text="@string/theme_dark"
                    android:textSize="13sp"
                    android:background="@drawable/chip_unselected"
                    android:textColor="@color/muted_foreground"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/pillThemeLight"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/theme_light"
                    android:textSize="13sp"
                    android:background="@drawable/chip_unselected"
                    android:textColor="@color/muted_foreground"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
